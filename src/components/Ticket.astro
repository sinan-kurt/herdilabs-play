---
import Icon from "./Icon.astro";
import type { Game } from "../data/games";
const { game } = Astro.props as { game: Game };
const live = game.status === "live";
const Tag = live ? "a" : "div";
---
<Tag class={`ticket ${live ? "" : "is-soon"}`} href={live ? `/oyun/${game.slug}/` : undefined}>
  {live
    ? <div class="art"><img src={game.cover} alt={`${game.title} oyunundan bir sahne`} loading="lazy" width="1200" height="750" /></div>
    : <div class="art soon" style={`background:${game.art?.bg};color:${game.art?.fg}`}><Icon name={game.art?.icon ?? "play"} /></div>}
  <div class="perf"></div>
  <div class="body">
    <h3>{game.title}</h3>
    <p class="tl">{game.tagline}</p>
    <div class="meta"><span>{game.genre}</span><span class="go">{live ? "Oyna →" : "Yakında"}</span></div>
  </div>
</Tag>
