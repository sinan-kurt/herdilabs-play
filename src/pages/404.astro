---
import Base from "../layouts/Base.astro";
---
<Base title="Sayfa bulunamadı">
  <section class="section">
    <div class="wrap" style="max-width:640px;text-align:center">
      <h1 style="font-size:64px;color:var(--coral)">Bu kabin boş.</h1>
      <p style="color:var(--muted);font-size:18px">Aradığın sayfa burada yok. Belki tren kaçırdı.</p>
      <p><a class="btn" href="/">Ana sayfaya dön</a></p>
    </div>
  </section>
</Base>
